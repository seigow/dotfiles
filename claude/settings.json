{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go fmt *)",
      "Bash(gofmt *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "mcp__github__get_issue",
      "mcp__github__get_issue_comments",
      "mcp__devinwiki__read_wiki_contents",
      "mcp__devinwiki__ask_question"
    ],
    "ask": [
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(git push *)",
      "Bash(git remote set-url *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "mcp__github__create_pull_request",
      "mcp__github__add_issue_comment"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(nc *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "model": "opus",
  "tui": "fullscreen"
}
